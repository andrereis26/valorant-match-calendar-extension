{
  "manifest_version": 3,
  "name": "Valorant Match Calendar",
  "version": "1.2.0",
  "description": "View upcoming professional Valorant matches and add them to Google Calendar.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3001/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Upcoming Valorant matches",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html"
}